{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/voz/al-iniciar.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash voz/di.sh:*)",
      "Bash(estudio/.venv/bin/python scripts/*)",
      "Bash(estudio/bin/ffmpeg:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)"
    ]
  }
}
