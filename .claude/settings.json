{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/voz/al-iniciar.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash voz/di.sh:*)",
      "Bash(estudio/.venv/bin/python scripts/:*)",
      "Bash(estudio/bin/ffmpeg:*)"
    ]
  }
}
